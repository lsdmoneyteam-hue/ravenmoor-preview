{
  // Ravenmoor Digital: the site (static files in this folder) plus the Worker in worker/.
  // Must match the project name in Cloudflare.
  "name": "ravenmoor-preview",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    // The site lives at the repo root; .assetsignore keeps the code and config out of it.
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths run the Worker. Pages, images and scripts are served directly.
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/a/*.mp4", "/globe/t/*", "/offplan/img2/*"]
  },
  // TEMPORARY: hand-over point for the globe artwork and store for the globe preview tiles
  // (see worker/drop.js and worker/globe.js). Remove with them.
  "kv_namespaces": [{ "binding": "DROP", "id": "bb72f195844449b1b20fc611e1cef212" },
    // The finished off-plan pictures (see worker/stills.js). Permanent.
    { "binding": "STILLS", "id": "5476f4b9cd3c4b5ca76c94d70843b52e" }],
  "d1_databases": [{ "binding": "DB", "database_name": "ravenmoor", "database_id": "fffb178d-a88f-4e4b-9ce5-a4fa6f4b1276" }],
  // 08:00 UTC every day: yesterday's digest to Telegram, and old tracking data removed.
  // Half past every hour: a reminder for any enquiry left on "new" for two hours (daytime only).
  "triggers": { "crons": ["0 8 * * *", "30 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true }
  }
}
