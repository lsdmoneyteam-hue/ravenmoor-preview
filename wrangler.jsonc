{
  // Ravenmoor Digital: the site (static files in this folder) plus the Worker in worker/.
  // Must match the project name in Cloudflare.
  "name": "ravenmoor-preview",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    // The site lives at the repo root; .assetsignore keeps the code and config out of it.
    "directory": ".",
    "binding": "ASSETS",
    // Only these paths run the Worker. Pages, images and scripts are served directly.
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/a/*.mp4"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "ravenmoor", "database_id": "fffb178d-a88f-4e4b-9ce5-a4fa6f4b1276" }],
  // 08:00 UTC every day: yesterday's digest to Telegram, and old tracking data removed.
  "triggers": { "crons": ["0 8 * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true }
  }
}
